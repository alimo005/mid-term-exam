<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="20dp"
    android:background="#FAF8F5">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:scaleType="fitCenter"
        android:contentDescription="Artwork Image"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artwork Details"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#292929"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/name_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#292929"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artist_name_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textColor="#625A54"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/Year_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:textColor="#625A54"
            android:textSize="17sp" />

        <Button
            android:id="@+id/website_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Visit Website"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#98462F"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/back_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Back to Gallery"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textColor="#514943"
            android:backgroundTint="#DED9D2"/>

    </LinearLayout>

</LinearLayout>
